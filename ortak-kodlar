--Trigger that logs stock changes

CREATE OR REPLACE TRIGGER trg_track_inventory_changes
AFTER UPDATE ON Products
FOR EACH ROW
BEGIN
    INSERT INTO InventoryLogs (product_id, change_amount, action_type, timestamp)
    VALUES (:NEW.product_id, (:NEW.stock_quantity - :OLD.stock_quantity), 'STOCK_UPDATE', SYSDATE);
END;
/

--Trigger that reduces stock when an order is placed

CREATE OR REPLACE TRIGGER trg_process_order_stock
AFTER INSERT ON OrderDetails
FOR EACH ROW
BEGIN
    UPDATE Products
    SET stock_quantity = stock_quantity - :NEW.quantity
    WHERE product_id = :NEW.product_id;
END;
/

--Checking to Prevent Stock from Falling Negative

CREATE OR REPLACE TRIGGER trg_check_stock_limit
BEFORE INSERT ON OrderDetails
FOR EACH ROW
DECLARE
    v_current_stock NUMBER;
BEGIN
    SELECT stock_quantity INTO v_current_stock
    FROM Products
    WHERE product_id = :NEW.product_id;

    IF v_current_stock < :NEW.quantity THEN
        RAISE_APPLICATION_ERROR(-20001, 'Insufficient stock!');
    END IF;
END;
/

