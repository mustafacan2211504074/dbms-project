-- ==========================================
-- LEEN'S MODULE ONLY: SHOP & CATALOG ARCHITECTURE
-- Format: Oracle SQL 
-- ==========================================

-- 1. SHOPS TABLE
CREATE TABLE Shops (
    shop_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    name VARCHAR2(100) NOT NULL,
    address VARCHAR2(255),
    rating NUMBER(2,1) CHECK (rating BETWEEN 0 AND 5),
    owner_id NUMBER, -- References Vendor IDs (26 & 27) from Users table
    is_active NUMBER(1) DEFAULT 1 CHECK (is_active IN (0, 1))
);

-- 2. CATEGORIES TABLE
CREATE TABLE Categories (
    category_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    category_name VARCHAR2(100) NOT NULL
);

-- 3. OPENING HOURS TABLE
CREATE TABLE OpeningHours (
    hour_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    shop_id NUMBER,
    time_details VARCHAR2(255),
    CONSTRAINT fk_shop_hours FOREIGN KEY (shop_id) REFERENCES Shops(shop_id) ON DELETE CASCADE
);


