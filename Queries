-- Problem 1: The marketplace platform needs to identify high-performing vendors to evaluate platform growth and analyze business performance.
--Management requires visibility into which shops are generating substantial economic activity, specifically filtering out low-performing or inactive vendors.

----------Q1(E)

  s.name AS ShopName,
    COUNT(DISTINCT o.order_id) AS TotalOrderCount,
    SUM(od.quantity * od.unit_price) AS TotalRevenue
FROM Shops s
JOIN Orders o ON s.shop_id = o.shop_id
JOIN OrderDetails od ON o.order_id = od.order_id
GROUP BY s.name
HAVING SUM(od.quantity * od.unit_price) > 500
ORDER BY TotalRevenue DESC;

--Problem 2: The operations team and customer support representatives need to track and manage unfulfilled transactions to prevent delays in fulfillment and ensure a smooth customer experience.
--To optimize workflow efficiency, they require a real-time list of customer orders that are currently stuck in the queue without being processed.

-----------Q2(E)

  SELECT 
    u.full_name AS CustomerName,
    o.order_id AS OrderID,
    o.total_price AS OrderTotal,
    o.status AS OrderStatus,
    o.order_date AS OrderDate
FROM Users u
JOIN Orders o ON u.user_id = o.customer_id
WHERE o.status = 'PENDING'
ORDER BY o.order_date DESC;

-- Problem 3: This query identifies high-performing product categories by filtering for flower shops with an average rating above 4.0.
-- The insights enable management to optimize the product catalog and promote top-tier categories on the homepage.

-----------Q3(L)

  SELECT 
    c.category_name AS CategoryName,
    ROUND(AVG(s.rating), 2) AS AverageShopRating,
    COUNT(DISTINCT s.shop_id) AS TotalShopsInCategory
FROM Categories c
JOIN Products p ON c.category_id = p.category_id
JOIN Shops s ON p.shop_id = s.shop_id
GROUP BY c.category_name
HAVING AVG(s.rating) > 4.0
ORDER BY AverageShopRating DESC;

-- Problem 4: This query identifies active, daily-operating vendors to support operational oversight. 
-- It combines shop schedules with vendor contact details to streamline administrative communication, profile audits, and onboarding management.

----------Q4(L)

SELECT 
    s.name AS ShopName,
    s.address AS ShopAddress,
    oh.time_details AS OperationHours,
    u.full_name AS VendorName,
    u.email AS VendorEmail
FROM Shops s
JOIN OpeningHours oh ON s.shop_id = oh.shop_id
JOIN Users u ON s.owner_id = u.user_id
WHERE s.is_active = 1
  AND LOWER(oh.time_details) LIKE '%everyday%'
ORDER BY s.name ASC;

--Problem 5:This query analyzes average customer ratings and total revenue by payment method for successful orders. It provides insights into customer satisfaction and transaction volume to help optimize payment options.

----------Q5(Z)

SELECT 
    p.payment_method AS PaymentMethod,
    COUNT(p.transaction_id) AS SuccessfulTransactions,
    SUM(o.total_price) AS TotalRevenue,
    ROUND(AVG(r.rating), 2) AS AverageCustomerRating
FROM Payments p
JOIN orders o ON p.order_id = o.order_id
JOIN Reviews r ON o.order_id = r.order_id
WHERE p.payment_status = 'Completed'
GROUP BY p.payment_method
HAVING SUM(o.total_price) > 500
ORDER BY TotalRevenue DESC;

